# Server Configuration
PORT=7575
NODE_ENV=development
PUBLIC_IP=127.0.0.1 # ganti dengan ip vps kamu

UPLOAD_PATH=./public/uploads
DB_PATH=./db/streamfire.db

# Base URL aplikasi (dipakai untuk OAuth redirect & scheduler internal)
# WAJIB diisi domain/IP publik jika memakai OAuth YouTube/Facebook
# Contoh: https://live.domainku.com  atau  http://123.45.67.89:7575
BASE_URL=http://localhost:7575

# Facebook Live (opsional, hanya jika ingin memakai Facebook API)
# Versi Graph API yang dipakai. Biarkan default jika tidak yakin.
FB_GRAPH_VERSION=v21.0

# Timezone server (default Asia/Jakarta)
TZ=Asia/Jakarta

# Kunci enkripsi token OAuth (WAJIB diganti, minimal 32 karakter acak)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=ganti-dengan-string-acak-panjang